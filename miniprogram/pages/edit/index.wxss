/**edit.wxss 编辑+背书合一页面（浅灰白极简 · 新拟态仪表盘风格）**/

/* 设计令牌（全局色板）：
   背景 #f5f6f8 / 卡片 #ffffff / 主文字 #1f2430 / 次文字 #6b7280
   辅助文字 #9aa0a6 / 主按钮 #2f3542 / 分割线 #e5e7eb / 荧光强调 #fff200 */

page {
  background: #f5f6f8;
  height: 100%;
}

/* 页面整体：纵向弹性布局，正文区占满剩余高度 */
.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
}

/* 离线模式提示条：浅灰卡片低饱和呈现 */
.offline-bar {
  margin: 16rpx 24rpx 0;
  padding: 14rpx 20rpx;
  background: #f0f2f5;
  color: #6b7280;
  font-size: 22rpx;
  border-radius: 10rpx;
  border: 1rpx solid #e5e7eb;
}

/* 通用按压反馈（按钮 hover-class） */
.press-hover {
  opacity: 0.7;
}

/* 模式切换：小型分段控件，选中项深灰胶囊底，未选中浅灰文字 */
.mode-switch {
  display: flex;
  margin: 24rpx 24rpx 0;
  padding: 6rpx;
  background: #eceef1;
  border-radius: 999rpx;
}

.mode-btn {
  flex: 1;
  text-align: center;
  padding: 8rpx 0;
  font-size: 24rpx;
  color: #9aa0a6;
  border-radius: 999rpx;
}

.mode-btn-active {
  background: #2f3542;
  color: #ffffff;
  font-weight: 500;
  box-shadow: 0 2rpx 6rpx rgba(47, 53, 66, 0.2);
}

/* 编辑模式内子页签：同款胶囊分段控件（小一号） */
.sub-tabs {
  display: flex;
  margin: 16rpx 24rpx 0;
  padding: 5rpx;
  background: #eceef1;
  border-radius: 999rpx;
}

.sub-tab {
  flex: 1;
  text-align: center;
  padding: 6rpx 0;
  font-size: 22rpx;
  color: #9aa0a6;
  border-radius: 999rpx;
}

.sub-tab-active {
  background: #2f3542;
  color: #ffffff;
  font-weight: 500;
  box-shadow: 0 2rpx 5rpx rgba(47, 53, 66, 0.18);
}

/* 顶部横排容器：标题输入 + 字号调节同一行 */
.top-row {
  display: flex;
  align-items: center;
  margin: 24rpx 24rpx 0;
}

/* 标题输入框：浅色圆角卡片，边框极轻 + 柔和阴影，占剩余宽度 */
.title-input {
  flex: 1;
  min-width: 0;
  padding: 18rpx 22rpx;
  background: #ffffff;
  border-radius: 14rpx;
  border: 1rpx solid #e5e7eb;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
  font-size: 30rpx;
  font-weight: 500;
  color: #1f2430;
}

/* 字号调节栏：浅色卡片，滑块为细轨道 + 小圆滑块，固定宽度 */
.font-bar {
  display: flex;
  align-items: center;
  flex: 0 0 370rpx;
  margin-left: 16rpx;
  padding: 8rpx 22rpx;
  background: #ffffff;
  border-radius: 14rpx;
  border: 1rpx solid #e5e7eb;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}

.font-label {
  flex-shrink: 0;
  margin-right: 20rpx;
  font-size: 24rpx;
  color: #6b7280;
}

.font-slider {
  flex: 1;
  margin: 0 16rpx;
}

.font-value {
  flex-shrink: 0;
  width: 56rpx;
  text-align: right;
  font-size: 24rpx;
  color: #9aa0a6;
}

/* 正文编辑区：占满剩余高度 */
.content-wrap {
  flex: 1;
  min-height: 0;
  margin: 16rpx 24rpx 0;
  background: #ffffff;
  border-radius: 14rpx;
  border: 1rpx solid #e5e7eb;
  overflow: hidden;
}

.content-input {
  box-sizing: border-box;
  width: 100%;
  height: 100%;
  padding: 24rpx;
  color: #1f2430;
}

/* 荧光标注渲染区 */
.mark-scroll {
  flex: 1;
  min-height: 0;
  margin: 16rpx 24rpx 0;
  background: #ffffff;
  border-radius: 14rpx;
  border: 1rpx solid #e5e7eb;
  overflow: hidden;
  box-sizing: border-box;
  /* 底部留白：与固定工具条隔离，滚动到底时最后一行不被按钮遮挡 */
  padding-bottom: 280rpx;
}

/* 文本容器：相对定位，作为遮罩与坐标换算的基准 */
.text-content {
  position: relative;
  box-sizing: border-box;
  min-height: 100%;
  padding: 24rpx;
  word-break: break-all;
}

/* 一行文本（\n 分段） */
.line {
  min-height: 1em;
}

/* 单个字符（标注字符通过内联样式带上荧光底色） */
.char {
  border-radius: 4rpx;
}

/* 空文本提示 */
.mark-empty {
  padding-top: 80rpx;
  text-align: center;
  font-size: 26rpx;
  color: #6b7280;
}

/* 涂抹/擦除预览遮罩（绝对定位在文本容器内，颜色由内联样式决定） */
.sel-overlay {
  position: absolute;
  border-radius: 4rpx;
}

/* 荧光笔操作栏：白底、细边框、柔和上浮阴影 */
.mark-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  background: #ffffff;
  border-radius: 16rpx 16rpx 0 0;
  border-top: 1rpx solid #e5e7eb;
  box-shadow: 0 -2rpx 12rpx rgba(31, 36, 48, 0.06);
  padding: 14rpx 24rpx;
  padding-bottom: calc(14rpx + env(safe-area-inset-bottom));
}

.color-row {
  display: flex;
  justify-content: center;
  margin-bottom: 10rpx;
}

/* 荧光色点：小巧整齐，细灰描边，选中加深灰环（强调色留给荧光色本身） */
.color-dot {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  margin: 0 10rpx;
  border: 2rpx solid #e5e7eb;
  box-sizing: border-box;
}

.color-dot-active {
  border-color: #2f3542;
}

.mark-bar-btns {
  display: flex;
}

/* 工具条按钮：小巧规格（上下内边距 10rpx、圆角 10rpx、字体 26rpx） */
.mark-bar-btn {
  flex: 1;
  text-align: center;
  padding: 10rpx 0;
  border-radius: 10rpx;
  font-size: 26rpx;
}

/* 当前工具提示行 */
.mark-bar-tip {
  text-align: center;
  font-size: 20rpx;
  color: #9aa0a6;
  margin-bottom: 8rpx;
}

/* 工具切换按钮（涂抹/擦除/浏览）：激活深灰胶囊实心，未激活浅灰底 */
.mark-bar-tool {
  flex: 1;
  background: #f0f2f5;
  color: #6b7280;
  margin-right: 8rpx;
}

.mark-bar-tool-on {
  background: #2f3542;
  color: #ffffff;
  font-weight: 500;
  box-shadow: 0 2rpx 5rpx rgba(47, 53, 66, 0.18);
}

/* 撤销小按钮：次要按钮——浅灰底 + 深灰文字 */
.mark-bar-undo {
  flex: 0 0 112rpx;
  margin-left: 8rpx;
  background: #f0f2f5;
  color: #1f2430;
}

/* 背书模式：挖空分组切换，三个小型圆角胶囊按钮横向排列
   当前选中组深灰实心，其余浅灰底 */
.dig-tabs {
  display: flex;
  margin: 16rpx 24rpx 0;
}

.dig-tab {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  font-size: 24rpx;
  color: #6b7280;
  background: #f0f2f5;
  border-radius: 999rpx;
  margin-right: 12rpx;
}

.dig-tab:last-child {
  margin-right: 0;
}

.dig-tab-active {
  background: #2f3542;
  color: #ffffff;
  font-weight: 500;
  box-shadow: 0 2rpx 6rpx rgba(47, 53, 66, 0.18);
}

/* 背书模式：挖空文本渲染区 */
.recite-scroll {
  flex: 1;
  min-height: 0;
  margin: 16rpx 24rpx 0;
  background: #ffffff;
  border-radius: 14rpx;
  border: 1rpx solid #e5e7eb;
  overflow: hidden;
}

.recite-content {
  box-sizing: border-box;
  padding: 24rpx;
  word-break: break-all;
  color: #1f2430;
}

/* 挖空占位段：细灰线下划线视觉（占位字符见 buildUnderscores）
   左右内边距扩大触摸命中区域，实现下划线附近的容错点击
   占位字符与原文等宽，按下展示原文时布局不跳动 */
.recite-seg-cloze {
  color: #9aa0a6;
  letter-spacing: 2rpx;
  padding: 4rpx 12rpx;
}

/* 按住挖空段展示原文：深灰文字，背景保持干净（仅文字颜色与占位区分） */
.recite-seg-reveal {
  color: #1f2430;
}

.recite-empty,
.recite-no-anno {
  padding-top: 80rpx;
  text-align: center;
  font-size: 26rpx;
  color: #6b7280;
}

.recite-no-anno {
  padding-top: 40rpx;
}

/* 底部保存栏 */
.save-bar {
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}

/* 主按钮：小巧深灰实心、居中，圆角 12rpx、左右内边距 32rpx */
.save-btn {
  width: auto;
  margin: 0 auto;
  padding: 12rpx 32rpx;
  background: #2f3542;
  color: #ffffff;
  text-align: center;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 500;
  box-shadow: 0 2rpx 8rpx rgba(47, 53, 66, 0.16);
}

.save-btn-hover {
  background: #4a5568;
}
